{
  "name": "drs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:contracts && pnpm --parallel --recursive dev",
    "build": "pnpm --recursive build",
    "test": "pnpm build:contracts && pnpm --recursive test",
    "typecheck": "pnpm build:contracts && pnpm --recursive typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:contracts": "pnpm --filter @drs/contracts build",
    "test:integracao": "pnpm build:contracts && pnpm --filter @drs/api test:integracao",
    "test:e2e": "pnpm build:contracts && pnpm --filter @drs/web test:e2e",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
